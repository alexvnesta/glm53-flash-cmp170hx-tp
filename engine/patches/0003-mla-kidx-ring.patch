--- a/exllamav3/cache/mla.py
+++ b/exllamav3/cache/mla.py
@@ -8,6 +8,169 @@ if TYPE_CHECKING:
     from ..modules import MLAttention
     from ..model import Config
 import numpy as np
+import os
+
+# k_idx ring (EXL3_MLA_KIDX_RING=W, default 0 = full plane): k-pool layers keep only W slots of the packed
+# [k || gate] plane per page, (pages, W, idx_dim), token t in slot (t % PAGE_SIZE) % W. The plane is read only
+# to (re)build the pools touched by the current forward: that forward's rows plus at most kpool - 1 earlier rows
+# of the same page (the open pool's "tail", in vLLM's terms). The ring rides the block table, so it is paged,
+# rotated, tiered, copied and TP-exported with its page like any other plane (QSAPlanes pattern, cache/qsa.py);
+# complete pages' ring rows are dead. Addressing is position-derived and nothing is rewound: rows rejected by
+# speculative decoding stay stale until re-advance overwrites them (as for DSV4LayerState, cache/dsa.py), which
+# is what the ring size must absorb. Graph steps (up to KIDX_RING_MAX_QLEN rows) stash all their rows before the
+# pool update reads them back; the eager path pools from its local chunk, reads the carry first, then stashes
+KIDX_RING_MAX_QLEN = 16   # bc_attn.MAX_QLEN == mla_attn.MAX_DECODE_QLEN
+# EXL3_KIDX_RING_SHADOW=1 (debug, small caches only): also keep full planes and check every forward's pools
+KIDX_SHADOW_MAX_PAGES = 256
+
+
+def kidx_ring_min_rows(kpool: int, num_spec: int = KIDX_RING_MAX_QLEN - 1) -> int:
+    # Adapted from vLLM (Apache-2.0), vllm/models/glm5next/common/attention.py, Glm5NextTailCache.
+    # get_kv_cache_spec @ 02e55d2a (PR #57169): "drafts behind a rejected pool-completing draft overwrite the
+    # keys read by its redo" unless the ring spans kpool + num_speculative_tokens rows, rounded up to a power
+    # of two pools. Here num_spec = (largest graph step) - 1, so GLM5.3 (kpool 4, steps <= 16 rows) needs 32
+    span = kpool + num_spec
+    return kpool * (1 << (-(-span // kpool) - 1).bit_length())
+
+
+def _kidx_ring(idx_dim, kpool, kidx_ring) -> int:
+    ring = int(os.environ.get("EXL3_MLA_KIDX_RING", 0) or 0) if kidx_ring is None else int(kidx_ring)
+    if not idx_dim:
+        return 0   # no indexer plane on this layer
+    assert ring == 0 or kpool, \
+        "EXL3_MLA_KIDX_RING requires a k-pool indexer: plain DSA scoring reads the whole k_idx plane"
+    # As vLLM requires its tail ring to divide the attention block size: then (t % PAGE_SIZE) % W == t % W
+    # (vLLM's pos % ring) and a pool's members sit in consecutive slots. A design simplification, not a
+    # correctness bound: (t % PAGE_SIZE) % W is collision-free for any W >= kpool + KIDX_RING_MAX_QLEN - 1
+    assert ring == 0 or (ring >= kidx_ring_min_rows(kpool) and PAGE_SIZE % ring == 0), \
+        f"k_idx ring must divide {PAGE_SIZE} and hold at least {kidx_ring_min_rows(kpool)} rows, got {ring}"
+    return ring
+
+
+def kidx_ring_check_setup(model, caches, max_spec_rows: int):
+    """Setup-time limits of the k_idx ring, for callers that know the longest speculative forward
+    (model_init.init: the cache's max_history + 1 rows). No-op unless a layer of `caches` has a ring.
+    1. Every speculative forward (graph step or eager verify) must fit KIDX_RING_MAX_QLEN rows: the
+       ring is sized so a rejected draft's rows never overwrite carry rows its redo reads, which holds
+       for steps of up to W - kpool + 2 rows (30 at W = 32) and is only guaranteed up to the graph's 16.
+    2. Prompt reuse must stay page aligned: Job copies a partial page for models without recurrent
+       state (generator/job.py), and a copied ring may lack the open pool's carry rows (_copy_idx_page
+       refuses). GLM5.3 is recurrent, so its Job never takes that path."""
+    rings = [getattr(layer, "kidx_ring", 0) for cache in caches if cache is not None
+             for layer in getattr(cache, "layers", {}).values()]
+    if not any(rings):
+        return
+    assert max_spec_rows <= KIDX_RING_MAX_QLEN, \
+        f"EXL3_MLA_KIDX_RING supports speculative forwards of at most {KIDX_RING_MAX_QLEN} rows " \
+        f"(num_draft_tokens + 1), got {max_spec_rows}"
+    assert model.caps.get("recurrent_states"), \
+        "EXL3_MLA_KIDX_RING requires a model with recurrent state: partial-page prompt reuse is not supported"
+
+
+class _KidxShadow:
+    """Full-plane twin of a ring layer's indexer planes (EXL3_KIDX_RING_SHADOW): the pre-ring layout, written and
+    pooled by the pre-ring code, compared against the ring layer's pools after every forward."""
+    kidx_ring = 0
+
+    def __init__(self, k_idx: torch.Tensor, k_pool: torch.Tensor):
+        self.k_idx = k_idx
+        self.k_pool = k_pool
+
+    def update_idx_direct(self, cache_seqlens, block_table, k_idx, length):
+        from ..modules.attention_fn.mla_triton import mla_plane_append
+        mla_plane_append(k_idx.reshape(k_idx.shape[0], length, self.k_idx.shape[-1]),
+                         self.k_idx, block_table, cache_seqlens)
+
+    def get_idx(self) -> torch.Tensor:
+        return self.k_idx
+
+    def get_pool(self) -> torch.Tensor:
+        return self.k_pool
+
+    def update_pool_direct(self, pool_seqlens, block_table, pool_keys):
+        from ..modules.attention_fn.mla_triton import mla_plane_append
+        mla_plane_append(pool_keys, self.k_pool, block_table, pool_seqlens)
+
+    def check(self, layer, block_table, host_seqlens, seqlen, open_pools):
+        """Byte-compare the ring layer with this twin after one forward of seqlen rows per batch row: the ring
+        slots it wrote, and the pools it built (complete ones; with open_pools also the open pool, which the
+        graph's pool update writes too). Raises on the first mismatch, naming the forward."""
+        ring, P = layer.kidx_ring, layer.kpool
+        epp = PAGE_SIZE // P
+        for b in range(block_table.shape[0]):
+            bt = block_table[b]
+            pos0 = host_seqlens[b]
+            end = pos0 + seqlen
+            tok = torch.arange(end - min(seqlen, ring), end, device = bt.device)
+            page = bt[tok // PAGE_SIZE].long()
+            ring_ok = torch.equal(layer.k_idx[page, (tok % PAGE_SIZE) % ring].view(torch.int16),
+                                  self.k_idx[page, tok % PAGE_SIZE].view(torch.int16))
+            pools = torch.arange(pos0 // P, -(-end // P) if open_pools else end // P, device = bt.device)
+            pp = bt[pools // epp].long()
+            pool_ok = torch.equal(layer.k_pool[pp, pools % epp].view(torch.int16),
+                                  self.k_pool[pp, pools % epp].view(torch.int16))
+            if not (ring_ok and pool_ok):
+                raise AssertionError(
+                    f"k_idx ring shadow mismatch ({'ring rows' if not ring_ok else 'pooled keys'}): layer "
+                    f"{getattr(layer.attention, 'layer_idx', '?')}, batch row {b}, pos0 {pos0}, rows {seqlen}, "
+                    f"open_pools {open_pools}")
+
+
+def _kidx_shadow_enabled(ring, pages, kidx_shadow) -> bool:
+    shadow = (os.environ.get("EXL3_KIDX_RING_SHADOW", "0") != "0") if kidx_shadow is None else bool(kidx_shadow)
+    if not ring:
+        return False
+    assert not shadow or pages <= KIDX_SHADOW_MAX_PAGES, \
+        f"EXL3_KIDX_RING_SHADOW is for small caches (<= {KIDX_SHADOW_MAX_PAGES} pages)"
+    return shadow
+
+
+def _update_idx(layer, cache_seqlens, block_table, k_idx, length):
+    """Shared update_idx_direct body. With a ring, only the last min(length, ring) rows are written.
+    That is vLLM's tail semantics (vllm/models/glm5next/nvidia/ops/kpool_compress.py, Apache-2.0:
+    decode stashes EVERY token -- gating the stash once left 3 stale ring entries in decode-built
+    pools -- and prefill seeds the trailing pool): every graph or verify step (<= 16 rows) is
+    stashed whole, and a long chunk keeps a superset of its tail. More rows than slots in one
+    launch would race on slots, and the callers pool a chunk's own rows before writing."""
+    from ..modules.attention_fn.mla_triton import mla_plane_append
+    rows = k_idx.reshape(k_idx.shape[0], length, layer.shape_i[-1])
+    ring = layer.kidx_ring
+    if ring and length > ring:
+        rows = rows[:, length - ring:]
+        cache_seqlens = cache_seqlens + (length - ring)
+    mla_plane_append(rows, layer.k_idx, block_table, cache_seqlens, ring = ring)
+
+
+def _copy_idx_page(layer, source, from_page, to_page, num_tokens):
+    if layer.k_idx is None:
+        return
+    assert layer.shape_i == source.shape_i
+    if not layer.kidx_ring:
+        layer.k_idx[to_page, :num_tokens, :].copy_(source.k_idx[from_page, :num_tokens, :], non_blocking = True)
+        return
+    # A pool left open by the copy (num_tokens % kpool != 0) would need the source page's carry rows, which its
+    # ring no longer holds once that page was written kpool - 1 + ring rows past them. Hybrid recurrent models
+    # (GLM5.3) never copy partial pages (Job skips it when a recurrent cache exists); refuse instead of corrupting
+    assert num_tokens % layer.kpool == 0, \
+        "partial-page copy into an open pool is not supported with the k_idx ring (EXL3_MLA_KIDX_RING)"
+    layer.k_idx[to_page].copy_(source.k_idx[from_page], non_blocking = True)
+    if layer.kidx_shadow is not None:
+        layer.kidx_shadow.k_idx[to_page, :num_tokens].copy_(
+            source.kidx_shadow.k_idx[from_page, :num_tokens], non_blocking = True)
+        n_pool = num_tokens // layer.kpool
+        layer.kidx_shadow.k_pool[to_page, :n_pool].copy_(
+            source.kidx_shadow.k_pool[from_page, :n_pool], non_blocking = True)
+
+
+def _shadow_tensors(layer) -> list:
+    # Page-major too, so rotation and the CPU tier carry the shadow with its page
+    return [layer.kidx_shadow.k_idx, layer.kidx_shadow.k_pool] if layer.kidx_shadow is not None else []
+
+
+def _shadow_size(layer) -> int:
+    if not layer.kidx_shadow_on:
+        return 0
+    return (int(np.prod(layer.shape_i[::2])) * PAGE_SIZE + int(np.prod(layer.shape_p))) * torch.half.itemsize
 
 
