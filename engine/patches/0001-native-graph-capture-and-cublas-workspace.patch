Subject: Native: scoped CUDA-graph capture cleanup and persistent cuBLAS workspace binding

CUDA graph capture is wrapped in a scope object (GraphCapture, graph.cuh). If the code between capture_begin()
and capture_end() throws, the scope ends the half-recorded capture, destroys the capture stream and the graph
handles and clears the recorded sites (Graph::capture_abort(), no-throw), instead of leaving a stream stuck in
capture mode. capture_end() checks its CUDA calls with AT_CUDA_CHECK and stops its node walk once every recorded
site is matched. Every native capture site uses the scope: attention, block-sparse MLP, DSV4 attention,
GDN/Mamba2 batched decode, gated MLP and MLA.

exl3_cublas_handle(stream) (new cublas_handle.cuh) binds ExLlama's persistent per-device workspace to the calling
thread's cuBLAS handle in one place; hgemm and Graph::launch use it instead of repeating the sequence by hand.
On torch 2.12 to 2.14 (CUDA) it asks torch for the handle without torch's own workspace setup and restores the
TF32/default math mode torch would have chosen; other torch versions and ROCm use the stock handle. hgemm also
checks that its tensors share a device, and hgemm_gr takes a device guard. The MLA graph path binds the handle
before capture for the DSA indexer mode, because a slot may be warmed on a different CPU thread while the model
loads.

Upstream: the same changes as turboderp-org/exllamav3 dev commits 4c6a7da (graph capture) and e8da92f (BLAS
workspace). graph.cuh, hgemm.cu, cublas_handle.cuh and four libtorch/*.cpp files are byte-identical to dev
2caf277; graph.cu, libtorch/attention.cpp and libtorch/mla_attention.cpp differ from it (see NOTES.md).
Tests: tests/native_lifecycle_cpu and tests/native_workspace_cpu (CPU-only source checks).

diff --git a/exllamav3/exllamav3_ext/cublas_handle.cuh b/exllamav3/exllamav3_ext/cublas_handle.cuh
new file mode 100644
index 0000000..be2c313
--- /dev/null
+++ b/exllamav3/exllamav3_ext/cublas_handle.cuh
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <torch/version.h>
+#include <ATen/Context.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <ATen/cuda/Exceptions.h>
+#include "quant/exl3_devctx.cuh"
+
+// Bind this thread/device handle to ExLlama's persistent workspace.
+// PyTorch 2.12 introduced the setup flag; keep the 2.6+ no-argument API
+// for older versions and unqualified future versions. ROCm owns its setup policy.
+inline cublasHandle_t exl3_cublas_handle(cudaStream_t stream)
+{
+#if defined(USE_ROCM) || TORCH_VERSION_MAJOR != 2 || TORCH_VERSION_MINOR < 12 || TORCH_VERSION_MINOR > 14
+    // Preserve backend math/atomics setup. This may reserve a redundant Torch
+    // workspace on CUDA, but does not require new ATen APIs.
+    cublasHandle_t handle = at::cuda::getCurrentCUDABlasHandle();
+#else
+    cublasHandle_t handle = at::cuda::getCurrentCUDABlasHandle(false);
+    // Match the verified 2.12-2.14 CUDA math-mode policy while skipping setup.
+    const bool tf32 = !at::NoTF32Guard::should_disable_tf32() &&
+        at::globalContext().float32Precision(at::Float32Backend::CUDA, at::Float32Op::MATMUL) == at::Float32Precision::TF32;
+    TORCH_CUDABLAS_CHECK(cublasSetMathMode(handle, tf32 ? CUBLAS_TF32_TENSOR_OP_MATH : CUBLAS_DEFAULT_MATH));
+#endif
+    TORCH_CUDABLAS_CHECK(cublasSetStream(handle, stream));
+    TORCH_CUDABLAS_CHECK(cublasSetPointerMode(handle, CUBLAS_POINTER_MODE_HOST));
+    int device;
+    AT_CUDA_CHECK(cudaGetDevice(&device));
+    void* workspace = DevCtx::instance().get_ws(device);
+    TORCH_CUDABLAS_CHECK(cublasSetWorkspace(handle, workspace, WORKSPACE_SIZE));
+    return handle;
+}
