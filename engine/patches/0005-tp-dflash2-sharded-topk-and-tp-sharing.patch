+    def tp_dispatch_lm_head_topk(self, args, k: int, scale: float = 1.0, softcap: float = 0.0):
+        """Sharded head top-k, adapted from Olt1z tp-mla's dispatcher.
+
+        Gather transformed fp32 scores with their global int64 IDs, then merge.
+        The output pseudo-worker participates even when it owns no head slice.
+        """
+        vocab_size = self.config.vocab_size
+        if not isinstance(k, int) or isinstance(k, bool) or not 0 < k <= vocab_size:
+            raise ValueError("top-k must fit the real vocabulary")
+        if not math.isfinite(scale) or not math.isfinite(softcap):
+            raise ValueError("selector scale and softcap must be finite")
+        if not self.active_devices or self.active_devices[-1] != self.tp_output_device:
+            raise ValueError("TP output pseudo-worker must be dispatched last")
+        ad, intervals = {}, []
+        for device in self.active_devices:
+            first, last, _ = self.plan[device]["lm_head"]
+            if first < 0 or last < first:
+                raise ValueError("invalid TP head allocation interval")
+            real_last = min(last, vocab_size)
+            if real_last > first:
+                ad[device] = (first, min(k, real_last - first))
+                intervals.append((first, real_last))
+        end = 0
+        for first, last in sorted(intervals):
+            if first != end:
+                raise ValueError("TP head allocation has a gap or overlap in the vocabulary")
+            end = last
+        if end != vocab_size:
+            raise ValueError("TP head allocation does not cover the real vocabulary")
+        self.tp_drain_acks()
+        if len(ad) == 1 and self.tp_output_device in ad:
+            return self.tp_worker_dispatch_single(
+                self.tp_output_device, mp_model_forward_lm_head_topk,
+                args + (ad[self.tp_output_device][0], None, None, k, vocab_size, scale, softcap),
+            )
+        gd = sorted(set(ad) | {self.tp_output_device})
+        ldims = [ad[d][1] if d in ad else 0 for d in gd]
+        gather_rows_per_chunk(ldims, SHBUF_SIZE_S)  # Check before entering any collective.
+        dispatched = []
+        for device in self.active_devices:
+            if device in gd:
+                self.tp_worker_dispatch(
+                    device, mp_model_forward_lm_head_topk,
+                    args + (ad[device][0] if device in ad else -1, gd, ldims,
+                            k, vocab_size, scale, softcap),
+                )
+                dispatched.append(device)
+        results = []
+        for device in dispatched:
+            result = self.tp_worker_result(device)
+            if result is not None:
+                results.append((device, result))
+        if len(results) != 1 or results[0][0] != self.tp_output_device:
+            raise RuntimeError("TP top-k result must come only from the output pseudo-worker")
+        return merge_topk(*results[0][1], k)
+
