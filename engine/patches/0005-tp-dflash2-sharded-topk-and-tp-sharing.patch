+++ b/exllamav3/util/tp_sharing.py
@@ -0,0 +1,60 @@
+"""Explicit TP CPU metadata sharing; no Torch or CUDA import here."""
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+ENVIRONMENT_KEY = "EXL3_TP_SHARING_STRATEGY"
+
+
+def select_parent_strategy(torch, environ=None):
+    """Preserve the historical default; explicit FD mode must be supported."""
+    environ = os.environ if environ is None else environ
+    requested = environ.get(ENVIRONMENT_KEY)
+    strategy = "file_system" if requested is None else requested
+    if strategy not in ("file_system", "file_descriptor"):
+        raise ValueError(ENVIRONMENT_KEY + " must be file_system or file_descriptor")
+    if strategy == "file_descriptor" and sys.platform != "linux":
+        raise ValueError("Explicit TP file_descriptor mode requires Linux")
+    if strategy not in torch.multiprocessing.get_all_sharing_strategies():
+        raise ValueError("Requested TP metadata strategy is unavailable: " + strategy)
+    torch.multiprocessing.set_sharing_strategy(strategy)
+    if torch.multiprocessing.get_sharing_strategy() != strategy:
+        raise RuntimeError("Torch did not install the requested TP sharing strategy")
+    # None leaves the historical child defaults unchanged. An explicit selection
+    # is carried in backend_args to every spawned and pseudo rank before init.
+    return strategy if requested is not None else None
+
+
+def install_rank_strategy(torch, backend_args, device, rank):
+    requested = backend_args.get("torch_sharing_strategy")
+    if requested is None:
+        return None
+    installed = select_parent_strategy(torch, {ENVIRONMENT_KEY: requested})
+    if installed != requested:
+        raise RuntimeError("TP rank sharing strategy does not match the parent")
+    report = sharing_report(torch, device, rank)
+    print(json.dumps({"glm_tp_sharing": report}, sort_keys=True), flush=True)
+    return report
+
+
+def sharing_report(torch, device, rank):
+    metadata = {"start_ticks": None, "fd_count": None,
+                "fd_soft_limit": None, "fd_hard_limit": None}
+    if sys.platform == "linux":
+        import resource
+        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
+        with open("/proc/self/stat", encoding="utf-8") as file:
+            stat_fields = file.read().rsplit(")", 1)[1].split()
+        metadata = {"start_ticks": stat_fields[19],
+                    "fd_count": len(os.listdir("/proc/self/fd")),
+                    "fd_soft_limit": soft, "fd_hard_limit": hard}
+    return {
+        "schema": 1, "pid": os.getpid(), "uid": os.getuid() if hasattr(os, "getuid") else None,
+        **metadata, "device": device, "rank": rank,
+        "sharing_strategy": torch.multiprocessing.get_sharing_strategy(),
+        "invocation_id": os.environ.get("INVOCATION_ID"),
+        "run_id": os.environ.get("GLM53_TRIAL_RUN_ID"),
+        "cuda_initialized": torch.cuda.is_initialized(),
+    }
