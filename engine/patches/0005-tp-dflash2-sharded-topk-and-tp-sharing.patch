+    def _sample_from_state_tp(self, target, state, params, dev):
+        """Candidate-only target TP path, adapted from Olt1z tp-mla.
+
+        Crop real vocabulary and apply the selector scale/softcap on each shard
+        before top-k. The shared head's own forward transformations stay intact.
+        The drafter and its ring remain on one GPU; target TP is independent.
