+def mp_model_forward_lm_head_topk(
+    local_context: dict,
+    shared_input: dict,
+    params: dict,
+    offset: int,
+    gather_devices: list[int] | None,
+    ldims: list[int] | None,
+    k: int,
+    vocab_size: int,
+    scale: float,
+    softcap: float,
+):
+    """Local head candidates and paired gather, adapted from Olt1z tp-mla.
+
+    Crop padding and transform scores before selection; no padded placeholder IDs
+    are introduced. Only the in-process output worker returns CUDA tensors.
+    """
+    consumer = local_context["inf_consumer"]
+    device = local_context["device"]
+    output_device = local_context["output_device"]
+    x = consumer.recv(shared_input)
+    if offset >= 0:
+        module = local_context["logits_module"]
+        logits = module.forward(module.prepare_for_device(x, params), params)
+        values, ids = transformed_topk(logits, vocab_size, k, offset, scale, softcap)
+    else:
+        values = torch.empty((*x.shape[:-1], 0), dtype=torch.float, device=x.device)
+        ids = torch.empty((*x.shape[:-1], 0), dtype=torch.long, device=x.device)
+    if gather_devices is None:
+        return values, ids
+    expected_width = ldims[gather_devices.index(device)]
+    if values.shape[-1] != expected_width:
+        raise ValueError("TP head candidate width disagrees with allocation plan")
+    return gather_candidates(
+        local_context["backend"], values, ids, gather_devices, output_device,
+        ldims, device == output_device, SHBUF_SIZE_S,
+    )
