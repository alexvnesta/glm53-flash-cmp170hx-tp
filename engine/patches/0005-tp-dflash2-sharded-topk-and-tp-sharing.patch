+"""Actual loader functions with CPU-only config/allocation sentinels."""
+import argparse
+import ast
+from pathlib import Path
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / "exllamav3/model_init.py"
+
+
+class Namespace(argparse.Namespace):
+    def __contains__(self, key):
+        return key in vars(self)
+
+
+class DraftConfig:
+    def __init__(self, enabled=False):
+        self.experimental_tensor_parallel = enabled
+        self.infer_params = SimpleNamespace()
+
+
+class BeforeAllocation(Exception):
+    pass
+
+
+def functions(config_factory=None, model_factory=None):
+    source = ast.parse(SOURCE.read_text())
+    names = {"add_args", "validate_dflash2_tp_args", "load_dflash2_tp_config", "init"}
+    tree = ast.Module(body=[node for node in source.body
+                           if isinstance(node, ast.FunctionDef) and node.name in names], type_ignores=[])
+    ns = {"__package__": "exllamav3", "ArgumentParser": argparse.ArgumentParser,
+          "Path": Path, "SimpleNamespace": SimpleNamespace,
+          "Config": SimpleNamespace(from_directory=config_factory),
+          "Model": SimpleNamespace(from_config=model_factory)}
+    exec(compile(tree, str(SOURCE), "exec"), ns)
+    return ns
+
+
+def args(ns, extra=()):
+    parser = argparse.ArgumentParser()
+    ns["add_args"](parser, add_draft_model_args=True)
+    return parser.parse_args(["-m", "/ABS/target", "-dm", "/ABS/draft", *extra], namespace=Namespace())
+
+
+class LoaderTests(unittest.TestCase):
+    def test_cli_default_off_and_explicit_true(self):
+        ns = functions()
+        self.assertIs(args(ns).experimental_dflash2_tp, False)
+        self.assertIs(args(ns, ("-tp", "--experimental-dflash2-tp")).experimental_dflash2_tp, True)
+
+    def test_flag_is_not_added_without_draft_arguments(self):
+        parser = argparse.ArgumentParser()
+        functions()["add_args"](parser, add_draft_model_args=False)
+        self.assertNotIn("--experimental-dflash2-tp", parser._option_string_actions)
+
+    def test_programmatic_opt_in_requires_exact_bool(self):
+        ns = functions()
+        for value in (1, 0, "true", "false", None, [], {}):
+            with self.subTest(value=value):
+                a = args(ns); a.experimental_dflash2_tp = value
+                with self.assertRaisesRegex(ValueError, "must be a bool"):
+                    ns["validate_dflash2_tp_args"](a)
+
+    def test_opt_in_invalid_profiles_refuse_before_config(self):
+        calls = []
+        ns = functions(lambda *a, **k: calls.append((a, k)))
+        for change in ({"tensor_parallel": False}, {"draft_model_dir": None}, {"mtp": True},
+                       {"draft_model_dir": "/ABS/target"}, {"tensor_parallel": 1}):
+            with self.subTest(change=change):
+                a = args(ns, ("-tp", "--experimental-dflash2-tp"))
+                vars(a).update(change)
+                with self.assertRaises(ValueError):
+                    ns["init"](a, quiet=True)
+                self.assertEqual(calls, [])
+
+    def test_default_config_call_has_no_new_kwarg(self):
+        calls = []
+        def config(directory, **kwargs):
+            calls.append((directory, kwargs))
+            return SimpleNamespace(infer_params=SimpleNamespace())
+        def allocate(*args, **kwargs):
+            raise BeforeAllocation()
+        ns = functions(config, allocate)
+        with self.assertRaises(BeforeAllocation):
+            ns["init"](args(ns), quiet=True)
+        self.assertEqual(calls, [("/ABS/target", {"layer_map": None}), ("/ABS/draft", {})])
+
+    def test_true_constructor_gate_reaches_model_factory(self):
+        calls, allocated = [], []
+        def config(directory, **kwargs):
+            calls.append((directory, kwargs))
+            return (DraftConfig(kwargs.get("experimental_tensor_parallel", False))
+                    if directory == "/ABS/draft" else SimpleNamespace(infer_params=SimpleNamespace()))
+        def allocate(config, **kwargs):
+            allocated.append(config)
+            if len(allocated) == 2:
+                self.assertIs(config.experimental_tensor_parallel, True)
+                raise BeforeAllocation()
+            return SimpleNamespace()
+        ns = functions(config, allocate)
+        module = ModuleType("exllamav3.architecture.dflash2"); module.DFlash2Config = DraftConfig
+        with patch.dict(sys.modules, {module.__name__: module}):
+            with self.assertRaises(BeforeAllocation):
+                ns["init"](args(ns, ("-tp", "--experimental-dflash2-tp")), quiet=True)
+        self.assertEqual(calls[-1], ("/ABS/draft", {"experimental_tensor_parallel": True}))
+        self.assertEqual(len(allocated), 2)
+
+    def test_wrong_architecture_or_dropped_gate_refuses_before_model(self):
+        for bad in (SimpleNamespace(experimental_tensor_parallel=True), DraftConfig(False)):
+            calls = []
+            def config(directory, **kwargs):
+                return bad if directory == "/ABS/draft" else SimpleNamespace(infer_params=SimpleNamespace())
+            ns = functions(config, lambda *a, **k: calls.append(a))
+            module = ModuleType("exllamav3.architecture.dflash2"); module.DFlash2Config = DraftConfig
+            with patch.dict(sys.modules, {module.__name__: module}):
+                with self.assertRaisesRegex(ValueError, "DFlash2DraftModel"):
+                    ns["init"](args(ns, ("-tp", "--experimental-dflash2-tp")), quiet=True)
+            self.assertEqual(calls, [])
+
+    def test_target_config_never_gets_draft_opt_in(self):
+        calls = []
+        def config(directory, **kwargs):
+            calls.append((directory, kwargs))
+            return DraftConfig(True) if directory == "/ABS/draft" else SimpleNamespace(infer_params=SimpleNamespace())
+        def allocate(*a, **k): raise BeforeAllocation()
+        ns = functions(config, allocate)
+        module = ModuleType("exllamav3.architecture.dflash2"); module.DFlash2Config = DraftConfig
+        with patch.dict(sys.modules, {module.__name__: module}):
+            with self.assertRaises(BeforeAllocation):
+                ns["init"](args(ns, ("-tp", "--experimental-dflash2-tp")), quiet=True)
+        self.assertEqual(calls[0], ("/ABS/target", {"layer_map": None}))
+
+
+if __name__ == "__main__": unittest.main()
