+"""Paired candidates for a sharded LM head.
+
+TP ordering is descending transformed score, then ascending global token id.
+This deterministic tie policy is not the dense CUDA kernel's lane ordering.
+"""
+import math
+import torch
+
+
+def transformed_topk(logits, vocab_size, k, offset=0, scale=1.0, softcap=0.0):
+    if not isinstance(k, int) or isinstance(k, bool) or not 0 < k <= vocab_size:
+        raise ValueError("top-k must fit the real vocabulary")
+    if offset < 0 or logits.ndim < 2:
+        raise ValueError("invalid shard offset or logits shape")
+    if not math.isfinite(scale) or not math.isfinite(softcap):
+        raise ValueError("selector scale and softcap must be finite")
+    width = max(0, min(logits.shape[-1], vocab_size - offset))
+    scores = logits[..., :width].float() * scale
+    if softcap > 0:
+        scores = torch.tanh(scores / softcap) * softcap
+    if torch.isnan(scores).any():
+        raise ValueError("NaN selector scores are unsupported")
+    # Stable sorting makes ties independent of shard partitioning. This correctness
+    # implementation deliberately pays a full local sort rather than claiming the
+    # dense CUDA kernel's tie policy or throughput.
+    ids = torch.argsort(scores, dim=-1, descending=True, stable=True)[..., :min(k, width)].clone()
+    values = scores.gather(-1, ids).contiguous()
+    return values, (ids + offset).contiguous()
+
+
+def merge_topk(values, ids, k):
+    if values.shape != ids.shape or ids.dtype != torch.long or values.dtype != torch.float:
+        raise ValueError("candidate values/ids must be paired fp32/int64 tensors")
+    if not 0 < k <= values.shape[-1]:
+        raise ValueError("not enough real candidates for top-k")
+    if values.device != ids.device or torch.isnan(values).any():
+        raise ValueError("invalid candidate device or NaN score")
+    by_id = torch.argsort(ids, dim=-1, stable=True)
+    values, ids = values.gather(-1, by_id), ids.gather(-1, by_id)
+    winners = torch.argsort(values, dim=-1, descending=True, stable=True)[..., :k].clone()
+    return values.gather(-1, winners).contiguous(), ids.gather(-1, winners).contiguous()
+
+
+def gather_rows_per_chunk(ldims, buffer_bytes):
+    if not ldims or any(not isinstance(n, int) or n < 0 for n in ldims) or sum(ldims) == 0:
+        raise ValueError("invalid candidate gather widths")
+    # The int64 ID gather is larger than the paired fp32 value gather.
+    rows = buffer_bytes // (8 * sum(ldims))
+    if rows < 1:
+        raise ValueError("one candidate row exceeds the small-gather buffer")
+    return rows
+
+
+def gather_candidates(backend, values, ids, gather_devices, output_device, ldims,
+                      is_output, buffer_bytes):
+    rows_per_chunk = gather_rows_per_chunk(ldims, buffer_bytes)
+    shape = values.shape[:-1]
+    rows = math.prod(shape)
+    local_width, total_width = values.shape[-1], sum(ldims)
+    flat_values = values.reshape(rows, local_width).contiguous()
+    flat_ids = ids.reshape(rows, local_width).contiguous()
+    out_values = torch.empty((rows, total_width), dtype=torch.float, device=values.device) if is_output else None
+    out_ids = torch.empty((rows, total_width), dtype=torch.long, device=ids.device) if is_output else None
+    for first in range(0, rows, rows_per_chunk):
+        last = min(rows, first + rows_per_chunk)
+        backend.gather_small(flat_values[first:last], out_values[first:last] if is_output else None,
+                             gather_devices, output_device, ldims)
+        backend.gather_small(flat_ids[first:last], out_ids[first:last] if is_output else None,
+                             gather_devices, output_device, ldims)
+    if not is_output:
+        return None
+    return out_values.reshape(*shape, total_width), out_ids.reshape(*shape, total_width)
diff --git a/exllamav3/util/tp_lazy_cache.py b/exllamav3/util/tp_lazy_cache.py
