+    ns = {"DFlashConfig": Base, "DFlash2Model": object, "no_default": object()}
+    module = ast.Module(body=[ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), cls], type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module), str(source), "exec"), ns)
+    assert ns["DFlash2Config"]("unused").experimental_tensor_parallel is False
+    assert ns["DFlash2Config"]("unused", experimental_tensor_parallel=True).experimental_tensor_parallel is True
