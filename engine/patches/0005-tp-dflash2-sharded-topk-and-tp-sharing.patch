+    target = SimpleNamespace(lm_head_topk=lambda rows, params, k, scale, softcap: (calls.append((rows, k, scale, softcap)), (torch.ones((1, 7, 16)), torch.zeros((1, 7, 16), dtype=torch.long)))[1])
