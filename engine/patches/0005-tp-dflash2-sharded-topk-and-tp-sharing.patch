+"""CPU transcription of deployed dflash2.cu's selection hierarchy.
+
+Models warp/lane/element tie ordering, not CUDA tanhf numerical rounding.
+Reference: deployed16a4979 dflash2.cu warp_topk/block_topk/topk_kernel.
+"""
+from math import inf
+
+
+def _warp_topk(lanes, k):
+    lanes = [list(lane) for lane in lanes]
+    result = []
+    for _ in range(k):
+        maxima = []
+        for lane in lanes:
+            value, arg = -inf, 0
+            for i, (score, _) in enumerate(lane):
+                if score > value:
+                    value, arg = score, i
+            maxima.append((value, arg))
+        winner = max(range(32), key=lambda lane: (maxima[lane][0], -lane))
+        score, arg = maxima[winner]
+        result.append((score, lanes[winner][arg][1]))
+        lanes[winner][arg] = (-inf, lanes[winner][arg][1])
+    return result
+
+
+def _block_topk(lanes, k):
+    partials = []
+    for first in range(0, 256, 32):
+        partials.extend(_warp_topk(lanes[first:first + 32], k))
+    m = k // 4
+    return _warp_topk([partials[lane*m:(lane+1)*m] for lane in range(32)], k)
+
+
+def dense_native_topk(scores, k, element_size=4):
+    if k not in (8, 16, 32) or element_size not in (2, 4) or len(scores) < k:
+        raise ValueError("unsupported native top-k geometry")
+    e = 16 if len(scores) <= 64*256*16 else 32
+    vec = 16 // element_size
+    splits = (len(scores) + 256*e - 1) // (256*e)
+    if splits > 64:
+        raise ValueError("native vocabulary limit exceeded")
+    partials = []
+    for split in range(splits):
+        lanes = []
+        for thread in range(256):
+            lane = []
+            for load in range(e // vec):
+                first = split*256*e + load*256*vec + thread*vec
+                for i in range(vec):
+                    token = first + i
+                    lane.append((scores[token] if token < len(scores) else -inf, token))
+            lanes.append(lane)
+        partials.extend(_block_topk(lanes, k))
+    m = k // 4
+    partials.extend([(-inf, -1)] * (256*m - len(partials)))
+    return _block_topk([partials[thread*m:(thread+1)*m] for thread in range(256)], k)
