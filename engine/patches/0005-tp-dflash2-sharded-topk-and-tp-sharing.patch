+"""CPU-only execution of the patched engine methods with inert transports.
+
+No ExLlama extension import, CUDA initialization, or live service access.
+Run: pytest -q tests/test_tp_dflash.py --engine-root ./exllamav3
+The adjacent conftest supplies --engine-root.
+"""
+import ast
+import importlib.util
+import math
+from pathlib import Path
+import threading
+import weakref
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+pytestmark = pytest.mark.nogpu
+from native_topk_reference import dense_native_topk
+
+
+def method(root, path, class_name, name, namespace):
+    source = root / "exllamav3" / path
+    tree = ast.parse(source.read_text())
+    owner = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == class_name) if class_name else tree
+    fn = next(n for n in owner.body if isinstance(n, ast.FunctionDef) and n.name == name)
+    fn.decorator_list = []
+    module = ast.Module(body=[ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), fn], type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module), str(source), "exec"), namespace)
+    return namespace[name]
+
+
+@pytest.fixture(scope="session")
+def api(request):
+    root = Path(request.config.getoption("--engine-root")).resolve()
+    utility_path = root / "exllamav3/util/candidate_topk.py"
+    spec = importlib.util.spec_from_file_location("candidate_topk_test", utility_path)
+    utility = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(utility)
+    ns = {"torch": torch, "math": math, "F": F, "SHBUF_SIZE_S": 16384,
+          "transformed_topk": utility.transformed_topk,
+          "merge_topk": utility.merge_topk,
+          "gather_candidates": utility.gather_candidates,
+          "gather_rows_per_chunk": utility.gather_rows_per_chunk}
+    worker = method(root, "model/model_tp_fn.py", None, "mp_model_forward_lm_head_topk", ns)
+    ns["mp_model_forward_lm_head_topk"] = worker
+    dispatch = method(root, "model/model_tp.py", "Model_TPMixin", "tp_dispatch_lm_head_topk", ns)
+    head = method(root, "model/model.py", "Model", "lm_head_topk", ns)
+    selector_ns = {"torch": torch, "F": F, "ext": SimpleNamespace(HAS_DFLASH2=False)}
+    selector = type("Selector", (), {})
+    for name in ("walk_block", "walk_candidates_block", "_validate_candidates", "_walk_torch"):
+        setattr(selector, name, method(root, "modules/arch_specific/dflash2.py", "DFlash2Selector", name, selector_ns))
+    return SimpleNamespace(root=root, utility=utility, worker=worker, dispatch=dispatch, head=head, selector=selector)
+
+
+class Coordinator:
+    def __init__(self, devices):
+        self.devices = devices
+        self.condition = threading.Condition()
+        self.receipts = {}
+        self.byte_counts = []
+
+    def backend(self, device):
+        coordinator = self
+
+        class Backend:
+            call = 0
+
+            def gather_small(self, tensor, out, devices, output, ldims):
+                call = self.call
+                self.call += 1
+                assert devices == coordinator.devices
+                assert tensor.shape[-1] == ldims[devices.index(device)]
+                total_bytes = tensor.shape[0] * sum(ldims) * tensor.element_size()
+                assert total_bytes <= 16384
+                with coordinator.condition:
+                    row = coordinator.receipts.setdefault(call, {})
+                    row[device] = tensor.clone()
+                    coordinator.byte_counts.append(total_bytes)
+                    coordinator.condition.notify_all()
+                    assert coordinator.condition.wait_for(lambda: len(row) == len(devices), timeout=5), "collective participant missing"
+                    if device == output:
+                        assert out is not None
+                        out.copy_(torch.cat([row[d] for d in devices], dim=-1))
+                    else:
+                        assert out is None
+
+        return Backend()
+
+
+class Engine:
+    def __init__(self, api, logits, widths, vocab, output):
+        self.api = api
+        self.config = SimpleNamespace(vocab_size=vocab)
+        self.active_devices = [d for d in range(len(widths)) if d != output] + [output]
+        self.tp_output_device = output
+        self.plan, self.contexts, self.results, self.threads = {}, {}, {}, {}
+        self.events = []
+        offsets = []
+        offset = 0
+        for width in widths:
+            offsets.append(offset)
+            offset += width
+        owners = [d for d, (a, width) in enumerate(zip(offsets, widths)) if a < vocab and width]
+        devices = sorted(set(owners) | {output})
+        self.coordinator = Coordinator(devices)
+        for device, (first, width) in enumerate(zip(offsets, widths)):
+            self.plan[device] = {"lm_head": (first, first + width, "channels")}
+            shard = logits[..., first:first + width]
+            # Execute real worker method and real candidate helpers; only head GEMM and
+            # backend transport are inert. The head's own transform is independent.
+            module = SimpleNamespace(prepare_for_device=lambda state, params: state,
+                                     forward=lambda state, params, shard=shard: shard)
+            self.contexts[device] = {"device": device, "output_device": output,
+                                     "inf_consumer": SimpleNamespace(recv=lambda shared: shared),
+                                     "logits_module": module, "backend": self.coordinator.backend(device)}
+
+    def tp_drain_acks(self):
+        self.events.append(("drain",))
+
+    def tp_worker_dispatch(self, device, fn, args):
+        self.events.append(("dispatch", device))
+
+        def run():
+            try:
+                self.results[device] = fn(self.contexts[device], *args)
+            except Exception as error:
+                self.results[device] = error
+
+        if device == self.tp_output_device:
+            run()  # Actual pseudo-worker's inline semantics.
+        else:
+            thread = threading.Thread(target=run, daemon=True)
+            self.threads[device] = thread
+            thread.start()
+
+    def tp_worker_result(self, device):
+        self.events.append(("result", device))
+        if device in self.threads:
+            self.threads[device].join(timeout=6)
+            assert not self.threads[device].is_alive()
+        result = self.results[device]
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+    def tp_worker_dispatch_single(self, device, fn, args):
+        self.tp_worker_dispatch(device, fn, args)
+        return self.tp_worker_result(device)
+
+
+def oracle(logits, vocab, k, scale, softcap):
+    scores = logits[..., :vocab].float() * scale
+    if softcap > 0:
+        scores = torch.tanh(scores / softcap) * softcap
+    # Independent Python ordering across the dense, real vocabulary.
+    ids = [[token for _, token in sorted(((float(score), token) for token, score in enumerate(row)), key=lambda p: (-p[0], p[1]))[:k]]
+           for row in scores.reshape(-1, vocab)]
+    ids = torch.tensor(ids, dtype=torch.long).reshape(*scores.shape[:-1], k)
+    return scores.gather(-1, ids), ids
+
+
+@pytest.mark.parametrize("widths,vocab,k,output", [
+    ([25, 25], 47, 16, 1), ([2, 1, 20], 23, 16, 2), ([0, 31], 31, 16, 0),
+    ([31, 8], 31, 16, 1), ([0, 31, 0], 31, 16, 1), ([4, 4], 8, 8, 0),
+])
+@pytest.mark.parametrize("scale,softcap", [(1.0, 0.0), (-2.0, 0.0), (0.0, 0.0), (3.0, 0.7)])
+def test_real_worker_dispatch_against_dense_oracle(api, widths, vocab, k, output, scale, softcap):
+    generator = torch.Generator().manual_seed(101)
+    logits = torch.randn((2, 7, sum(widths)), generator=generator)
+    logits[..., vocab:] = 10000  # Padding must never displace a real candidate.
+    engine = Engine(api, logits, widths, vocab, output)
+    state = torch.zeros((2, 7, 3))
+    actual = api.dispatch(engine, (state, {}), k, scale, softcap)
+    expected = oracle(logits, vocab, k, scale, softcap)
+    torch.testing.assert_close(actual[0], expected[0], rtol=0, atol=0)
+    assert torch.equal(actual[1], expected[1])
+    dispatched = [event[1] for event in engine.events if event[0] == "dispatch"]
+    assert dispatched[-1] == output
+    assert all(engine.results[d] is None for d in dispatched if d != output)
+
