+def make_selector(api, vocab=47, k=16, rank=4):
+    rng = torch.Generator().manual_seed(4)
+    selector = api.selector()
+    selector.vocab_size, selector.top_k, selector.rank = vocab, k, rank
+    selector.pred_codebook = torch.randn((vocab, rank), generator=rng)
+    selector.succ_codebook = torch.randn((vocab, rank), generator=rng)
+    selector.hidden_proj = SimpleNamespace(forward=lambda hidden, params: hidden[..., :rank])
+    return selector
