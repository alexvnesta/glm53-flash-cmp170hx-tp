diff --git a/exllamav3/generator/job.py b/exllamav3/generator/job.py
index 1296db3..85da260 100644
--- a/exllamav3/generator/job.py
+++ b/exllamav3/generator/job.py
@@ -1354,7 +1354,7 @@ class Job:
         return new_pages
 
 
-    def prefill(self, results: list):
+    def prefill(self, results: list, chunk_size: int | None = None):
         """
         Run prompt prefill chunks for already allocated cache pages.
 
@@ -1362,6 +1362,9 @@ class Job:
         sequence's kv_position through the prompt, skipping any prefix whose K/V pages were already cached, running
         model forward passes for uncached chunks, updating page hashes as pages become complete, and stashing
         recurrent checkpoints when applicable. It emits progress events but does not sample new completion tokens.
+
+        chunk_size, if given, bounds the forward pass of this call below the generator's max_chunk_size (fair
+        scheduling while other jobs are generating). It does not bound the cached-page skip.
         """
 
         if self.time_first_prefill is None:
@@ -1408,6 +1411,12 @@ class Job:
                     prefill_end = local_idx * PAGE_SIZE
                     break
 
+            # A reduced chunk bounds the forward pass only, after the cached pages above were skipped at the
+            # full max_chunk_size window, so a job resuming a cached prompt walks it as fast as before. Prompts
+            # with embeddings keep the full chunk so their multimodal spans are chunked as usual
+            if chunk_size is not None and not self.embeddings:
+                prefill_end = min(prefill_end, (prefill_start + chunk_size) // PAGE_SIZE * PAGE_SIZE)
+
             if prefill_end <= prefill_start:
                 continue
 
diff --git a/tests/generator/test_fair_scheduling.py b/tests/generator/test_fair_scheduling.py
new file mode 100644
index 0000000..bc116d5
--- /dev/null
+++ b/tests/generator/test_fair_scheduling.py
@@ -0,0 +1,222 @@
+"""
+Fair scheduling between prompt ingestion and generation (Generator fair_gen_rounds / fair_chunk_size).
+
+While the active set mixes a job that still ingests its prompt with one that is already generating, iterate()
+runs up to fair_gen_rounds generation rounds (draft, hybrid substitution, verify) per prefill round, and the
+prefill round runs chunks of at most fair_chunk_size tokens. With the defaults the scheduler is upstream's: one
+round, Job.prefill(results) with the full max_chunk_size.
+
+No GPU or model: Generator is built with __new__ around stub jobs (as in test_failure_containment.py), and
+Job.prefill runs on a real Job up to the model call (as in test_multimodal_rewind_prefill.py).
+"""
+
+import inspect
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from exllamav3.constants import PAGE_SIZE
+from exllamav3.generator.generator import Generator
+from exllamav3.generator.job import Job
+from exllamav3.tokenizer import MMEmbedding
+
+pytestmark = pytest.mark.nogpu
+
+
+# Generator.iterate() with stub jobs
+
+class StubPagetable:
+    def num_unreferenced_pages(self):
+        return 1 << 30
+
+
+class StubJob:
+    """generating: prefill is done. Otherwise each prefill() call emits one "prefill" result (forward work done),
+    unless cached_only, which models a round that only walked cached pages (no result)."""
+    def __init__(self, name, generating, cached_only = False):
+        self.name = name
+        self.generating = generating
+        self.cached_only = cached_only
+        self.prefill_calls = []
+        self.serial_number = 0
+        self.sequences = [SimpleNamespace()]
+
+    def is_prefill_done(self):
+        return self.generating
+
+    def prefill(self, *args):
+        self.prefill_calls.append(args)
+        if not self.generating and not self.cached_only:
+            args[0].append({"job": self, "stage": "prefill", "eos": False, "serial": 0})
+
+
+def make_generator(jobs, fair_gen_rounds = None, fair_chunk_size = None, hybrid = 0):
+    g = Generator.__new__(Generator)
+    if fair_gen_rounds is not None:
+        g.fair_gen_rounds = fair_gen_rounds
+    if fair_chunk_size is not None:
+        g.fair_chunk_size = fair_chunk_size
+    g.pagetable = StubPagetable()
+    g.pending_jobs = []
+    g.active_jobs = list(jobs)
+    g.max_batch_size = 16
+    g.cache = SimpleNamespace(initialized = True)
+    g.draft_cache = None
+    g.recurrent_cache = None
+    g.draft_model = None
+    g.ngram_match_min = 0
+    g.hybrid_draft_tokens = hybrid
+    g.visualizer = None
+    g.disk_page_cache = None
+    g.gen_calls = []
+    g.iterate_gen = lambda results, draft_tokens = None: g.gen_calls.append(draft_tokens)
+    return g
+
+
+def test_fair_arguments_are_explicit_with_old_defaults():
+    # Unknown keyword arguments fall into **kwargs and are ignored, so a caller relying on fair scheduling must
+    # find these two as real parameters
+    params = inspect.signature(Generator.__init__).parameters
+    assert params["fair_gen_rounds"].default == 1
+    assert params["fair_chunk_size"].default is None
+    assert Generator.fair_gen_rounds == 1 and Generator.fair_chunk_size is None
+
+
+def test_defaults_are_upstream_scheduling():
+    prefilling, generating = StubJob("p", False), StubJob("g", True)
+    g = make_generator([prefilling, generating])
+    g.iterate()
+    assert prefilling.prefill_calls == [(prefilling.prefill_calls[0][0],)]   # one positional argument
+    assert generating.prefill_calls == [(generating.prefill_calls[0][0],)]
+    assert len(g.gen_calls) == 1
+
+
+def test_fair_rounds_and_chunk_while_mixed():
+    prefilling, generating = StubJob("p", False), StubJob("g", True)
+    g = make_generator([prefilling, generating], fair_gen_rounds = 4, fair_chunk_size = 2 * PAGE_SIZE)
+    g.iterate()
+    assert [c[1:] for c in prefilling.prefill_calls] == [(2 * PAGE_SIZE,)]
+    assert len(g.gen_calls) == 4
+
+
+def test_no_contention_means_no_fair_scheduling():
+    for jobs in ([StubJob("p", False)], [StubJob("g1", True), StubJob("g2", True)],
+                 [StubJob("p1", False), StubJob("p2", False)]):
+        g = make_generator(jobs, fair_gen_rounds = 4, fair_chunk_size = 2 * PAGE_SIZE)
+        g.iterate()
+        for job in jobs:
+            assert [len(c) for c in job.prefill_calls] == [1]
+        assert len(g.gen_calls) == 1
+
+
+def test_cached_page_walk_gets_no_extra_rounds():
+    prefilling, generating = StubJob("p", False, cached_only = True), StubJob("g", True)
+    g = make_generator([prefilling, generating], fair_gen_rounds = 4, fair_chunk_size = 2 * PAGE_SIZE)
+    g.iterate()
+    assert [c[1:] for c in prefilling.prefill_calls] == [(2 * PAGE_SIZE,)]
+    assert len(g.gen_calls) == 1
+
+
+def test_rounds_stop_when_contention_ends():
+    prefilling, generating = StubJob("p", False), StubJob("g", True)
+    g = make_generator([prefilling, generating], fair_gen_rounds = 4)
+
+    def gen(results, draft_tokens = None):
+        g.gen_calls.append(draft_tokens)
+        if len(g.gen_calls) == 2:
+            g.active_jobs.remove(generating)   # finished (or requeued) during round 2
+    g.iterate_gen = gen
+    g.iterate()
+    assert len(g.gen_calls) == 2
+    # fair_gen_rounds alone does not shrink the chunk
+    assert [len(c) for c in prefilling.prefill_calls] == [1]
+
+
+def test_every_fair_round_drafts_and_substitutes_hybrid():
+    prefilling, generating = StubJob("p", False), StubJob("g", True)
+    g = make_generator([prefilling, generating], fair_gen_rounds = 3, hybrid = 15)
+    hybrid_calls = []
+
+    def hybrid_gen(draft_tokens):
+        hybrid_calls.append(draft_tokens)
+        return torch.full((1, 15), len(hybrid_calls))
+    g.iterate_hybrid_gen = hybrid_gen
+    g.iterate()
+    assert hybrid_calls == [None, None, None]
+    assert [int(d[0, 0]) for d in g.gen_calls] == [1, 2, 3]
+
+
+# Job.prefill(results, chunk_size) on a real Job, up to the model call
+
+class ModelBoundaryReached(Exception):
+    pass
+
+
+class ModelProbe:
+    def __init__(self):
+        self.caps = {}
+        self.calls = []
+
+    def prefill(self, *, input_ids, params):
+        self.calls.append((input_ids, params))
+        raise ModelBoundaryReached
+
+    forward = prefill
+
+
+def make_job(prompt_length, start, image = False, max_chunk_size = 2048):
+    ids = torch.arange(prompt_length, dtype = torch.long)[None] % 1000
+    embeddings = []
+    if image:
+        count = 3 * 4 * 6
+        embedding = MMEmbedding(
+            embeddings = torch.zeros((count, 1)),
+            token_string = torch.full((1, count), -1, dtype = torch.long),
+            grid_thw = (3, 8, 12),
+            mrope_merge_size = 2,
+        )
+        ids[:, 300:300 + count] = embedding.token_string
+        embeddings = [embedding]
+    job = Job(input_ids = ids, embeddings = embeddings)
+    seq = job.sequences[0]
+    seq.kv_position = start
+    seq.block_index_tensor = torch.tensor([[0]], dtype = torch.int32)
+    # A recurrent target's checkpoint at the current position ends the cached-page walk and skips the partial-page
+    # copy (the GLM-5.3 case)
+    job.recurrent_state = SimpleNamespace(position = start, target = SimpleNamespace(position = start))
+    job.alt_rope_freqs = None
+    job.alt_rope_offset = 0
+    job.generator = SimpleNamespace(
+        model = ModelProbe(),
+        max_chunk_size = max_chunk_size,
+        recurrent_cache = object(),
+        cache = None,
+        draft_model = None,
+        mtp_draft = False,
+        dflash_draft = False,
+    )
+    return job
+
+
+def forward_span(job, *args):
+    with pytest.raises(ModelBoundaryReached):
+        job.prefill([], *args)
+    (ids, params), = job.generator.model.calls
+    start = params["cache_seqlens"].item()
+    torch.testing.assert_close(ids, job.sequences[0].sequence_ids.torch_slice(start, start + ids.shape[-1]))
+    return start, start + ids.shape[-1]
+
+
+def test_job_prefill_chunk_size_bounds_the_forward():
+    assert forward_span(make_job(8000, 0)) == (0, 2048)
+    assert forward_span(make_job(8000, 0), None) == (0, 2048)
+    assert forward_span(make_job(8000, 0), 512) == (0, 512)
+    assert forward_span(make_job(8000, 1024), 512) == (1024, 1536)
+    # Never longer than max_chunk_size, nor past the prompt's last page boundary
+    assert forward_span(make_job(8000, 0), 4096) == (0, 2048)
+    assert forward_span(make_job(700, 0), 2048) == (0, 512)
+
+
+def test_job_prefill_chunk_size_skips_multimodal_prompts():
+    assert forward_span(make_job(8000, 0, image = True), 512) == (0, 2048)
